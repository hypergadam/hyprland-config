# ---- Environment ----
export EDITOR="vim"
export VISUAL="vim"
export PAGER="less"
export LESS="-R --mouse"

export GOPATH="$HOME/go"

# typeset -U keeps the array unique, so re-sourcing this file (or a parent
# process having already exported these) can't grow PATH with duplicates.
typeset -U path PATH
path=(
  "$HOME/.local/bin"
  "$HOME/bin"
  "$HOME/.cargo/bin"
  "$HOME/.strix/bin"
  /usr/local/go/bin
  "$GOPATH/bin"
  $path
)
export PATH

# ---- Palette ----
# Generated by `theme-apply` from ~/.config/theme/palette.toml. Exports
# FZF_COLORS, EZA_COLORS and LS_COLORS; sourced early because the completion
# zstyles below read LS_COLORS. Colour only -- options stay in this file.
[[ -f "$HOME/.config/theme/shell-colors.sh" ]] && source "$HOME/.config/theme/shell-colors.sh"

# ---- Completion cache ----
# Regenerating kubectl/helm completions on every shell costs ~300ms, which is
# the latency a slow prompt usually gets blamed for. Cache them, and refresh
# only when the binary is newer than the cached file.
ZSH_COMPLETION_CACHE="$HOME/.cache/zsh/completions"
mkdir -p "$ZSH_COMPLETION_CACHE"
fpath=("$ZSH_COMPLETION_CACHE" $fpath)
for _tool in kubectl helm; do
  if (( $+commands[$_tool] )); then
    if [[ ! -f "$ZSH_COMPLETION_CACHE/_$_tool" \
       || $commands[$_tool] -nt "$ZSH_COMPLETION_CACHE/_$_tool" ]]; then
      $_tool completion zsh > "$ZSH_COMPLETION_CACHE/_$_tool" 2>/dev/null
    fi
  fi
done
unset _tool

# ---- Oh My Zsh ----
export ZSH="$HOME/.oh-my-zsh"

# Empty: the prompt is starship, wired up at the bottom of this file.
ZSH_THEME=""

DISABLE_AUTO_UPDATE="true"
HIST_STAMPS="yyyy-mm-dd"

# history-substring-search must load after zsh-syntax-highlighting, which
# wraps the same widgets -- the other order leaves the arrow keys dead.
plugins=(
  git
  golang
  docker
  docker-compose
  kubectl
  fzf
  sudo
  command-not-found
  zsh-completions
  zsh-autosuggestions
  zsh-syntax-highlighting
  history-substring-search
)

fpath+=("$ZSH_CUSTOM/plugins/zsh-completions/src")

source "$ZSH/oh-my-zsh.sh"

# ---- History ----
HISTFILE="$HOME/.zsh_history"
HISTSIZE=100000
SAVEHIST=100000

setopt SHARE_HISTORY
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_SPACE
setopt HIST_REDUCE_BLANKS
setopt HIST_VERIFY
setopt INC_APPEND_HISTORY
setopt EXTENDED_HISTORY

# ---- Completion ----
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}' 'r:|[._-]=* r:|=*' 'l:|=* r:|=*'
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"
zstyle ':completion:*' group-name ''
zstyle ':completion:*:descriptions' format '%F{yellow}-- %d --%f'
zstyle ':completion:*:warnings' format '%F{red}no matches for %d%f'
zstyle ':completion:*' use-cache on
zstyle ':completion:*' cache-path "$HOME/.cache/zsh"

# ---- Key bindings ----
bindkey -e
bindkey '^[[A' history-substring-search-up
bindkey '^[[B' history-substring-search-down
bindkey '^ ' autosuggest-accept
bindkey '^[w' kill-region

# ---- Autosuggestions ----
ZSH_AUTOSUGGEST_STRATEGY=(history completion)
# ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE comes from the palette (shell-colors.sh).
: ${ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE:="fg=#6d5a68"}

# ---- fzf ----
[ -f /usr/share/fzf/shell/key-bindings.zsh ] && source /usr/share/fzf/shell/key-bindings.zsh
[ -f /usr/share/fzf/shell/completion.zsh ] && source /usr/share/fzf/shell/completion.zsh

# $FZF_COLORS is palette-generated; the layout options are mine.
export FZF_DEFAULT_OPTS="--height 40% --layout=reverse --border=rounded --info=inline --preview-window=right:60%:border-left ${FZF_COLORS}"
export FZF_CTRL_T_OPTS="--preview 'bat --color=always --style=numbers {}'"
export FZF_ALT_C_OPTS="--preview 'eza --tree --level=2 --colour=always --icons=auto {}'"

# ---- Aliases ----
alias ls='eza --group-directories-first --icons=auto'
alias ll='eza -lah --group-directories-first --icons=auto --git --time-style=long-iso'
alias la='eza -a --group-directories-first --icons=auto'
alias lt='eza --tree --level=2 --group-directories-first --icons=auto'
alias cat='bat --paging=never --style=plain'
alias g='git'
alias k='kubectl'
alias d='docker'
alias dc='docker compose'
alias v='$EDITOR'

alias gob='go build ./...'
alias got='go test ./...'
alias gor='go run .'

# ---- Zoxide ----
(( $+commands[zoxide] )) && eval "$(zoxide init zsh)"

# ---- NVM ----
# Sourcing nvm.sh costs ~280ms of a ~460ms startup, and all it does up front is
# put the default version's bin on PATH. So do that part directly and defer the
# rest until `nvm` is actually called. node/npm/npx are available immediately;
# only `nvm` itself pays the load cost, once per shell.
#
# To go back to eager loading, replace this whole block with:
#   [ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"
export NVM_DIR="$HOME/.nvm"
if [[ -s "$NVM_DIR/nvm.sh" ]]; then
  if [[ -r "$NVM_DIR/alias/default" ]]; then
    _nvm_want="$(<"$NVM_DIR/alias/default")"
    # default may point at an alias ("lts/*" -> "lts/krypton" -> "v24.15.0")
    _nvm_hops=0
    while [[ -r "$NVM_DIR/alias/$_nvm_want" && $_nvm_hops -lt 3 ]]; do
      _nvm_want="$(<"$NVM_DIR/alias/$_nvm_want")"
      (( _nvm_hops++ ))
    done
    # (/Nn[-1]): directories only, no error if none, numerically sorted, last
    _nvm_bin=("$NVM_DIR/versions/node/v${_nvm_want#v}"*/bin(/Nn[-1]))
    (( $#_nvm_bin )) && path=("${_nvm_bin[1]}" $path)
    unset _nvm_want _nvm_hops _nvm_bin
  fi
  nvm() {
    unset -f nvm
    . "$NVM_DIR/nvm.sh"
    [[ -s "$NVM_DIR/bash_completion" ]] && . "$NVM_DIR/bash_completion"
    nvm "$@"
  }
fi

# ---- fzf legacy config ----
[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh

# ---- Prompt ----
# Last, so nothing loaded above can overwrite PROMPT. Colours live in
# ~/.config/starship.toml, generated from the palette by `theme-apply`.
(( $+commands[starship] )) && eval "$(starship init zsh)"
