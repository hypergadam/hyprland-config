def r_bat(t: Theme, dry: bool) -> None:
    """
    bat discovers .tmTheme files under ~/.config/bat/themes and needs
    `bat cache --build` to pick up changes (done in reload_all). bat/config
    names the theme, so it stays hand-editable.
    """
    def colour(role: str) -> str:
        return t.term[role] if role in t.term else t.hex(role)

    rules = []
    for name, scope, role, style in BAT_SCOPES:
        extra = (f"\n\t\t\t\t<key>fontStyle</key>\n"
                 f"\t\t\t\t<string>{style}</string>") if style else ""
        rules.append(
            f"\t\t<dict>\n"
            f"\t\t\t<key>name</key>\n\t\t\t<string>{name}</string>\n"
            f"\t\t\t<key>scope</key>\n\t\t\t<string>{scope}</string>\n"
            f"\t\t\t<key>settings</key>\n\t\t\t<dict>\n"
            f"\t\t\t\t<key>foreground</key>\n"
            f"\t\t\t\t<string>{colour(role)}</string>{extra}\n"
            f"\t\t\t</dict>\n"
            f"\t\t</dict>"
        )

    write(CFG / "bat/themes/Palette.tmTheme", f"""<?xml version="1.0" encoding="UTF-8"?>
