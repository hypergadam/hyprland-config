def r_btop(t: Theme, dry: bool) -> None:
    """
    btop reads themes from ~/.config/btop/themes; btop.conf names one via
    color_theme, so it stays hand-editable. The *_start/_mid/_end triples are
    gradient stops, which is why the graphs get three colours each.
    """
    k = t.term
    pairs = {
        "main_bg":      "" if t.opacity.get("terminal", 1.0) != 1.0 else t.hex("bg"),
        "main_fg":      t.hex("fg"),
        "title":        t.extra.get("cursor", t.hex("fg")),
        "hi_fg":        t.hex("accent"),
        "selected_bg":  t.hex("bg_selected"),
        "selected_fg":  t.hex("accent"),
        "inactive_fg":  t.hex("fg_disabled"),
        "graph_text":   t.hex("fg_muted"),
        "meter_bg":     t.hex("bg_raised"),
        "proc_misc":    k["bright_cyan"],
        "cpu_box":      t.hex("outline"),
        "mem_box":      t.hex("outline"),
        "net_box":      t.hex("outline"),
        "proc_box":     t.hex("outline"),
        "div_line":     t.hex("outline"),
    }
    grads = {
        "temp":      (k["cyan"], t.hex("warning"), t.hex("error")),
        "cpu":       (t.hex("success"), t.hex("warning"), t.hex("error")),
        "free":      (t.hex("success"), k["bright_green"], k["green"]),
        "cached":    (k["cyan"], k["bright_cyan"], k["blue"]),
        "available": (t.hex("warning"), k["bright_yellow"], k["yellow"]),
        "used":      (t.hex("error"), k["bright_red"], k["red"]),
        "download":  (k["cyan"], k["bright_cyan"], k["blue"]),
        "upload":    (t.hex("accent"), k["bright_red"], k["magenta"]),
        "process":   (t.hex("info"), k["bright_blue"], k["cyan"]),
    }
    body = "".join(f'theme[{key}]="{val}"\n' for key, val in pairs.items())
    body += "\n"
    for name, (s, m, e) in grads.items():
        body += (f'theme[{name}_start]="{s}"\n'
                 f'theme[{name}_mid]="{m}"\n'
                 f'theme[{name}_end]="{e}"\n')
    write(CFG / "btop/themes/palette.theme", f"""# {BANNER}
# Theme: {t.name}
# main_bg is left empty so btop inherits the terminal's translucent
# background instead of painting an opaque rectangle over it.

{body}""", dry)


def check_breeze_contract(t: Theme) -> list[str]:
    """Every @*_breeze name the installed theme dereferences must be defined."""
    import re
    needed: set[str] = set()
    for f in BREEZE_CSS:
        if f.exists():
            needed |= set(re.findall(r"@([a-z0-9_]+_breeze)", f.read_text()))
    # names the theme defines for itself don't need to come from us
    selfdef: set[str] = set()
    for f in BREEZE_CSS:
        if f.exists():
            selfdef |= set(re.findall(r"@define-color\s+([a-z0-9_]+_breeze)", f.read_text()))
    return sorted(needed - selfdef - set(_breeze_map(t)))


def run(cmd: list[str]) -> bool:
    try:
        return subprocess.run(cmd, capture_output=True, timeout=10).returncode == 0
    except Exception:
        return False


def reload_all(t: Theme) -> None:
    results = []

    results.append(("hyprland", run(["hyprctl", "reload"])))

    # waybar reloads its stylesheet on SIGUSR2
    results.append(("waybar", run(["pkill", "-USR2", "-x", "waybar"])))

    results.append(("swaync", run(["swaync-client", "--reload-css"])))

    if t.wallpaper:
        results.append(("wallpaper", run(["systemctl", "--user", "restart",
                                          "hypr-wallpaper.service"])))

    # kitty only listens when remote control is enabled; harmless if not
    results.append(("kitty", run(["kitten", "@", "set-colors", "--all", "--configured",
                                  str(CFG / "kitty/current-theme.conf")])))

    # bat keeps a compiled cache of its themes; without this the new
    # .tmTheme is on disk but invisible to bat.
    results.append(("bat", run(["bat", "cache", "--build"])))

    # starship re-reads its config on every prompt, and shell-colors.sh is
    # picked up by the next shell -- nothing to signal for either.
    results.append(("starship", True))

    # zellij reads its theme at session start, btop at launch; neither
    # supports being signalled, so running instances are left alone.
    results.append(("zellij", True))
    results.append(("btop", True))

    # kdeglobals is written by r_kdeglobals -- deliberately no kwriteconfig6
    # here, which would reformat the file and make the next run non-idempotent.
    # Qt apps read it at launch, so there is nothing to signal.
    results.append(("kde/qt", True))

    # Nudge GTK apps: toggling the theme name forces a re-read of colors.css
    run(["gsettings", "set", "org.gnome.desktop.interface", "gtk-theme", "Adwaita"])
    run(["gsettings", "set", "org.gnome.desktop.interface", "gtk-theme", "Breeze-Dark"])
    results.append(("gtk", True))

    print("\nreload:")
    for name, ok in results:
        print(f"  {'ok  ' if ok else 'skip'} {name}")


# --------------------------------------------------------------------------
def main() -> None:
    ap = argparse.ArgumentParser(description="Render all themed configs from palette.toml")
    ap.add_argument("--no-reload", action="store_true", help="write files only")
    ap.add_argument("--dry-run", action="store_true", help="show what would change")
    ap.add_argument("--check", action="store_true", help="verify colour contracts only")
    args = ap.parse_args()

    t = load()
    print(f"theme: {t.name}  accent: {t.hex('accent')}")

    missing = check_breeze_contract(t)
    if missing:
        print(f"\nWARNING: {len(missing)} Breeze colour(s) referenced but not generated:")
        for m in missing:
            print(f"  - {m}")
    else:
        print("breeze colour contract: complete")

    if args.check:
        sys.exit(1 if missing else 0)

    for fn in (r_hyprland, r_hyprlock, r_waybar, r_swaync,
               r_fuzzel, r_kitty, r_wezterm, r_wallpaper,
               r_gtk, r_kde, r_kdeglobals,
               r_starship, r_shell_colors, r_bat, r_zellij, r_btop):
        fn(t, args.dry_run)

    verb = "would write" if args.dry_run else "wrote"
    print(f"\n{verb} {len(WRITTEN)} file(s), {len(SKIPPED)} unchanged:")
    for p in WRITTEN:
        print(f"  + {p}")

    if not args.no_reload and not args.dry_run:
        reload_all(t)


if __name__ == "__main__":
    main()
