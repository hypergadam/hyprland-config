def _sgr(hexv: str, bg: bool = False) -> str:
    """#rrggbb -> an SGR truecolour parameter run, e.g. 38;2;225;90;72"""
    h = hexv.lstrip("#")
    r, g, b = (int(h[i:i + 2], 16) for i in (0, 2, 4))
    return f"{48 if bg else 38};2;{r};{g};{b}"


