#!/usr/bin/env python3
"""
theme-apply - render every themed component from ~/.config/theme/palette.toml

Design notes
------------
Each component is themed through its OWN native include mechanism, so this
script only ever writes a small generated colour file. Your real configs
(hyprland.lua, style.css, kitty.conf ...) stay hand-editable and are never
overwritten -- they just reference the generated tokens.

  hyprland  require("theme")        -> hypr/theme.lua
  hyprlock  source = ...            -> hypr/theme-colors.conf
  waybar    @import url(colors.css) -> waybar/colors.css
  swaync    @import url(colors.css) -> swaync/colors.css
  fuzzel    include=...             -> fuzzel/colors.ini
  kitty     include current-theme   -> kitty/current-theme.conf
  gtk3/4    @import 'colors.css'    -> gtk-{3,4}.0/colors.css
  qt/kde    ColorScheme=            -> color-schemes/Theme.colors
  zellij    theme "palette"         -> zellij/themes/palette.kdl
  btop      color_theme =           -> btop/themes/palette.theme
  bat       --theme in bat/config   -> bat/themes/Palette.tmTheme
  fzf/eza   source in .zshrc        -> theme/shell-colors.sh
  starship  (no include of its own) -> a block in starship.toml

Usage:  theme-apply [--no-reload] [--dry-run]
"""
from __future__ import annotations
import argparse, os, shutil, subprocess, sys, tomllib
from pathlib import Path

HOME = Path.home()
CFG = HOME / ".config"
THEME_DIR = CFG / "theme"
PALETTE = THEME_DIR / "palette.toml"

BANNER = "GENERATED by theme-apply from ~/.config/theme/palette.toml -- do not edit"


# --------------------------------------------------------------------------
# palette loading
# --------------------------------------------------------------------------
class Theme:
    def __init__(self, data: dict):
        self.name = data.get("name", "unnamed")
        self.wallpaper = data.get("wallpaper")
        self.palette: dict[str, str] = data["palette"]
        self.opacity: dict = data.get("opacity", {})
        def resolve(group: str) -> dict[str, str]:
            out: dict[str, str] = {}
            for name, key in data.get(group, {}).items():
                if key not in self.palette:
                    sys.exit(f"palette.toml: [{group}] '{name}' points at "
                             f"unknown colour '{key}'")
                out[name] = self.palette[key]
            return out

        # resolve semantic names -> literal hex, failing loudly on typos
        self.role = resolve("roles")      # UI surfaces
        self.term = resolve("terminal")   # the 16 ANSI slots
        self.extra = resolve("extra")     # odds and ends

        required_term = [
            "black", "red", "green", "yellow", "blue", "magenta", "cyan", "white",
            "bright_black", "bright_red", "bright_green", "bright_yellow",
            "bright_blue", "bright_magenta", "bright_cyan", "bright_white",
        ]
        missing = [k for k in required_term if k not in self.term]
        if missing:
            sys.exit(f"palette.toml: [terminal] missing {', '.join(missing)}")

    def hex(self, role: str) -> str:
        """#rrggbb"""
        return self.role[role]

    def bare(self, role: str) -> str:
        """rrggbb (no leading #)"""
        return self.role[role].lstrip("#")

    def rgba_hypr(self, role: str, alpha: str = "ff") -> str:
        """Hyprland/hyprlock rgba(rrggbbaa)"""
        return f"rgba({self.bare(role)}{alpha})"

    def rgb_tuple(self, role: str) -> tuple[int, int, int]:
        h = self.bare(role)
        return tuple(int(h[i:i + 2], 16) for i in (0, 2, 4))

    def css_rgba(self, role: str, a: float) -> str:
        r, g, b = self.rgb_tuple(role)
        return f"rgba({r}, {g}, {b}, {a})"

    def kde(self, role: str) -> str:
        """KDE .colors wants r,g,b"""
        return ",".join(str(c) for c in self.rgb_tuple(role))

    def mix(self, role_a: str, role_b: str, amount: float) -> str:
        """Blend role_a toward role_b. amount=0 -> a, 1 -> b."""
        a, b = self.rgb_tuple(role_a), self.rgb_tuple(role_b)
        return "#" + "".join(f"{round(x + (y - x) * amount):02x}"
                             for x, y in zip(a, b))

    @staticmethod
    def kde_hex(hexv: str) -> str:
        h = hexv.lstrip("#")
        return ",".join(str(int(h[i:i + 2], 16)) for i in (0, 2, 4))

    def raw(self, key: str) -> str:
        """Reach a palette colour directly (for things with no semantic role)."""
        return self.palette[key]


def load() -> Theme:
    if not PALETTE.exists():
        sys.exit(f"missing {PALETTE}")
    with PALETTE.open("rb") as fh:
        return Theme(tomllib.load(fh))


# --------------------------------------------------------------------------
# file writing
# --------------------------------------------------------------------------
WRITTEN: list[Path] = []
SKIPPED: list[Path] = []


def write(path: Path, content: str, dry: bool) -> None:
    path = Path(path)
    if path.exists() and path.read_text() == content:
        SKIPPED.append(path)
        return
    if dry:
        WRITTEN.append(path)
        return
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(content)
    WRITTEN.append(path)


def write_region(path: Path, tag: str, body: str, dry: bool) -> None:
    """
    Replace a delimited region inside a config we do NOT otherwise own.

    For a component with no include mechanism of its own, owning one clearly
    marked block at the end of the user's config is the next best thing: the
    hand-written part above the markers is never touched, and the generated
    part is still obviously generated.
    """
    path = Path(path)
    start, end = f"# >>> theme-apply:{tag} >>>", f"# <<< theme-apply:{tag} <<<"
    region = f"{start}\n# {BANNER}\n{body.rstrip()}\n{end}\n"
    old = path.read_text() if path.exists() else ""
    if start in old and end in old:
        head, _, rest = old.partition(start)
        _, _, tail = rest.partition(end)
        new = head + region + tail.lstrip("\n")
    else:
        new = (old.rstrip() + "\n\n" if old.strip() else "") + region
    if new == old:
        SKIPPED.append(path)
        return
    if dry:
        WRITTEN.append(path)
        return
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(new)
    WRITTEN.append(path)


# --------------------------------------------------------------------------
# renderers - one per component
# --------------------------------------------------------------------------
def r_hyprland(t: Theme, dry: bool) -> None:
    """Lua table consumed by hyprland.lua via require('theme')."""
    oa = t.opacity.get("border_active", "ff")
    oi = t.opacity.get("border_inactive", "bb")
    write(CFG / "hypr/theme.lua", f"""-- {BANNER}
-- Theme: {t.name}
return {{
    name            = "{t.name}",

    accent          = "{t.rgba_hypr('accent', oa)}",
    accent_dim      = "{t.rgba_hypr('accent_dim', oa)}",
    border_inactive = "{t.rgba_hypr('outline_inactive', oi)}",

    -- shadow wants 0xAARRGGBB
    shadow          = 0x55{t.bare('bg_deep')},

    bg              = "{t.rgba_hypr('bg')}",
    fg              = "{t.rgba_hypr('fg')}",
}}
""", dry)


def r_hyprlock(t: Theme, dry: bool) -> None:
    """hyprlang variables sourced by hyprlock.conf."""
    img = CFG / "hypr/wallpapers" / t.wallpaper if t.wallpaper else None
    wallpaper_line = f"$wallpaper  = {img}\n" if img and img.exists() else ""
    write(CFG / "hypr/theme-colors.conf", f"""# {BANNER}
# Theme: {t.name}
$accent     = {t.rgba_hypr('accent')}
$accent_dim = {t.rgba_hypr('accent_dim')}
$bg         = {t.rgba_hypr('bg')}
$bg_deep    = {t.rgba_hypr('bg_deep')}
$bg_raised  = {t.rgba_hypr('bg_raised')}
$fg         = {t.rgba_hypr('fg')}
$fg_muted   = {t.rgba_hypr('fg_muted')}
$error      = {t.rgba_hypr('error')}
{wallpaper_line}""", dry)


def _css_vars(t: Theme) -> str:
    return "".join(f"@define-color {role} {hexv};\n"
                   for role, hexv in sorted(t.role.items()))


def r_waybar(t: Theme, dry: bool) -> None:
    panel = int(t.opacity.get("panel", "f2"), 16) / 255
    write(CFG / "waybar/colors.css", f"""/* {BANNER} */
/* Theme: {t.name} */
{_css_vars(t)}
/* composite surfaces */
@define-color panel_bg {t.css_rgba('bg', round(panel, 3))};
@define-color panel_border {t.css_rgba('accent', 0.16)};

/* Derived bar text tones. The raw muted/disabled roles are tuned for large
   UI surfaces and fall below WCAG AA at 12px on a dark bar, so these lift
   them toward the foreground. Blends of theme colours, so any palette works. */
@define-color bar_value {t.mix('fg_muted', 'fg', 0.45)};
@define-color bar_idle {t.mix('fg_disabled', 'fg', 0.40)};
""", dry)


def r_swaync(t: Theme, dry: bool) -> None:
    """
    swaync 0.12+ is GTK4 and uses real CSS custom properties (var(--x)), not
    @define-color -- so we must satisfy its documented variable contract
    rather than emit colour definitions.
    """
    r, g, b = t.rgb_tuple("bg_dim")
    write(CFG / "swaync/colors.css", f"""/* {BANNER} */
/* Theme: {t.name} */
:root {{
  /* swaync's own variable contract (see /etc/xdg/swaync/style.css) */
  --cc-bg: {t.hex('bg')};
  --noti-border-color: {t.hex('outline')};
  --noti-bg: {r}, {g}, {b};
  --noti-bg-alpha: 1;
  --noti-bg-darker: {t.hex('bg_deep')};
  --noti-bg-hover: {t.hex('bg_raised')};
  --noti-bg-focus: {t.hex('bg_selected')};
  --noti-close-bg: {t.hex('bg_raised')};
  --noti-close-bg-hover: {t.hex('bg_selected')};
  --text-color: {t.hex('fg')};
  --text-color-disabled: {t.hex('fg_muted')};
  --bg-selected: {t.hex('accent')};

  /* our semantic palette, for this config's own rules */
  --accent: {t.hex('accent')};
  --accent-dim: {t.hex('accent_dim')};
  --accent-text: {t.hex('accent_text')};
  --bg: {t.hex('bg')};
  --bg-dim: {t.hex('bg_dim')};
  --bg-raised: {t.hex('bg_raised')};
  --fg: {t.hex('fg')};
  --fg-muted: {t.hex('fg_muted')};
  --outline: {t.hex('outline')};
}}
""", dry)


def r_fuzzel(t: Theme, dry: bool) -> None:
    """fuzzel include files carry their own section scope."""
    write(CFG / "fuzzel/colors.ini", f"""# {BANNER}
# Theme: {t.name}
[colors]
background={t.bare('bg')}{t.opacity.get('launcher', 'fa')}
