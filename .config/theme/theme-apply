def _breeze_map(t: Theme) -> dict[str, str]:
    """
    Semantic mapping of every @*_breeze colour the Breeze GTK theme consumes.

    Breeze-Dark's gtk.css references these ~86 names but never defines them;
    upstream they come from colorreload-gtk-module reading the KDE colour
    scheme. We generate them from our palette instead, which is what makes a
    Breeze-shaped widget set wear Catppuccin colours without patching the
    theme itself.

    Naming convention in Breeze:
      *_backdrop      -> window is unfocused
      *_insensitive   -> widget is disabled
    """
    dis_err = t.mix("error", "bg", 0.65)
    dis_warn = t.mix("warning", "bg", 0.65)
    dis_ok = t.mix("success", "bg", 0.65)
    dim_accent = t.mix("accent", "bg", 0.60)
    btn_bg = t.hex("bg_raised")
    btn_bg_dis = t.mix("bg_raised", "bg", 0.50)

    m = {
        # --- core surfaces -------------------------------------------------
        "theme_bg_color": t.hex("bg"),
        "theme_fg_color": t.hex("fg"),
        "theme_base_color": t.hex("bg_dim"),
        "theme_text_color": t.hex("fg"),
        "content_view_bg": t.hex("bg_dim"),
        "borders": t.hex("outline"),

        # --- selection -----------------------------------------------------
        "theme_selected_bg_color": t.hex("accent"),
        "theme_selected_fg_color": t.hex("accent_text"),
        "theme_hovering_selected_bg_color": t.hex("accent_dim"),
        "theme_view_active_decoration_color": t.hex("accent"),
        "theme_view_hover_decoration_color": t.hex("accent_dim"),

        # --- links / status ------------------------------------------------
        "link_color": t.hex("info"),
        "link_visited_color": t.extra.get("link_visited", t.hex("accent")),
        "error_color": t.hex("error"),
        "error_color_backdrop": t.hex("error"),
        "error_color_insensitive": dis_err,
        "error_color_insensitive_backdrop": dis_err,
        "warning_color": t.hex("warning"),
        "warning_color_backdrop": t.hex("warning"),
        "warning_color_insensitive": dis_warn,
        "warning_color_insensitive_backdrop": dis_warn,
        "success_color": t.hex("success"),
        "success_color_backdrop": t.hex("success"),
        "success_color_insensitive": dis_ok,
        "success_color_insensitive_backdrop": dis_ok,

        # --- tooltips --------------------------------------------------------
        "tooltip_background": t.hex("bg_raised"),
        "tooltip_text": t.hex("fg"),
        "tooltip_border": t.hex("outline"),

        # --- disabled --------------------------------------------------------
        "insensitive_bg_color": t.hex("bg_dim"),
        "insensitive_fg_color": t.hex("fg_disabled"),
        "insensitive_base_color": t.hex("bg_dim"),
        "insensitive_base_fg_color": t.hex("fg_disabled"),
        "insensitive_borders": t.hex("outline_inactive"),
        "insensitive_selected_bg_color": t.hex("bg_raised"),
        "insensitive_selected_fg_color": t.hex("fg_disabled"),
        "insensitive_unfocused_bg_color": t.hex("bg_dim"),
        "insensitive_unfocused_fg_color": t.hex("fg_disabled"),
        "insensitive_unfocused_selected_bg_color": t.hex("bg_raised"),
        "insensitive_unfocused_selected_fg_color": t.hex("fg_disabled"),

        # --- unfocused window -------------------------------------------------
        "theme_unfocused_bg_color": t.hex("bg"),
        "theme_unfocused_fg_color": t.hex("fg_muted"),
        "theme_unfocused_base_color": t.hex("bg_dim"),
        "theme_unfocused_text_color": t.hex("fg_muted"),
        "theme_unfocused_view_bg_color": t.hex("bg_dim"),
        "theme_unfocused_view_text_color": t.hex("fg_disabled"),
        "theme_unfocused_selected_bg_color": t.mix("accent", "bg", 0.40),
        "theme_unfocused_selected_bg_color_alt": t.mix("accent", "bg", 0.40),
        "theme_unfocused_selected_fg_color": t.hex("accent_text"),
        "unfocused_borders": t.hex("outline"),
        "unfocused_insensitive_borders": t.hex("outline_inactive"),
        "unfocused_insensitive_color": t.hex("fg_disabled"),

        # --- buttons -----------------------------------------------------------
        "theme_button_background_normal": btn_bg,
        "theme_button_background_backdrop": btn_bg,
        "theme_button_background_insensitive": btn_bg_dis,
        "theme_button_background_backdrop_insensitive": btn_bg_dis,
        "theme_button_foreground_normal": t.hex("fg"),
        "theme_button_foreground_backdrop": t.hex("fg_muted"),
        "theme_button_foreground_insensitive": t.hex("fg_disabled"),
        "theme_button_foreground_backdrop_insensitive": t.hex("fg_disabled"),
        "theme_button_foreground_active": t.hex("accent"),
        "theme_button_foreground_active_backdrop": t.hex("accent"),
        "theme_button_foreground_active_insensitive": t.hex("fg_disabled"),
        "theme_button_foreground_active_backdrop_insensitive": t.hex("fg_disabled"),
        "theme_button_decoration_focus": t.hex("accent"),
        "theme_button_decoration_focus_backdrop": t.hex("accent_dim"),
        "theme_button_decoration_focus_insensitive": dim_accent,
        "theme_button_decoration_focus_backdrop_insensitive": dim_accent,
        "theme_button_decoration_hover": t.hex("accent"),
        "theme_button_decoration_hover_backdrop": t.hex("accent_dim"),
        "theme_button_decoration_hover_insensitive": dim_accent,
        "theme_button_decoration_hover_backdrop_insensitive": dim_accent,

        # --- headerbars / titlebars ---------------------------------------------
        "theme_header_background": t.hex("bg_dim"),
        "theme_header_background_backdrop": t.hex("bg_dim"),
        "theme_header_background_light": t.hex("bg_raised"),
        "theme_header_foreground": t.hex("fg"),
        "theme_header_foreground_backdrop": t.hex("fg_muted"),
        "theme_header_foreground_insensitive": t.hex("fg_disabled"),
        "theme_header_foreground_insensitive_backdrop": t.hex("fg_disabled"),
        "theme_titlebar_background": t.hex("bg_dim"),
        "theme_titlebar_background_backdrop": t.hex("bg_dim"),
        "theme_titlebar_background_light": t.hex("bg_raised"),
        "theme_titlebar_foreground": t.hex("fg"),
        "theme_titlebar_foreground_backdrop": t.hex("fg_muted"),
        "theme_titlebar_foreground_insensitive": t.hex("fg_disabled"),
        "theme_titlebar_foreground_insensitive_backdrop": t.hex("fg_disabled"),

        # --- misc ----------------------------------------------------------------
        "print_paper_backdrop": "#ffffff",
    }
    return {f"{k}_breeze": v for k, v in m.items()}


# Names Breeze-Dark's gtk.css actually dereferences. Generated by scanning the
# installed theme; theme-apply --check verifies we still satisfy all of them.
BREEZE_CSS = [Path("/usr/share/themes/Breeze-Dark/gtk-3.0/gtk.css"),
              Path("/usr/share/themes/Breeze-Dark/gtk-4.0/gtk.css")]


def r_wallpaper(t: Theme, dry: bool) -> None:
    """
    The wallpaper belongs to the theme, so palette.toml names it and
    start-wallpaper.sh reads the path from here. Falls back silently when a
    palette declares no wallpaper.
    """
    if not t.wallpaper:
        return
    img = CFG / "hypr/wallpapers" / t.wallpaper
    if not img.exists():
        print(f"\nWARNING: wallpaper '{t.wallpaper}' not found at {img}")
        return
    write(CFG / "hypr/theme-wallpaper", f"# {BANNER}\n{img}\n", dry)


def r_wezterm(t: Theme, dry: bool) -> None:
    """
    WezTerm auto-discovers TOML colour schemes in ~/.config/wezterm/colors/.
    wezterm.lua just names the scheme, so it stays hand-editable.
    """
    k = t.term
    ansi = [k["black"], k["red"], k["green"], k["yellow"],
            k["blue"], k["magenta"], k["cyan"], k["white"]]
    bright = [k["bright_black"], k["bright_red"], k["bright_green"],
              k["bright_yellow"], k["bright_blue"], k["bright_magenta"],
              k["bright_cyan"], k["bright_white"]]
    q = lambda xs: ", ".join(f'"{c}"' for c in xs)
    write(CFG / "wezterm/colors/palette.toml", f"""# {BANNER}
[metadata]
name = "Palette"
author = "theme-apply"

[colors]
foreground    = "{t.hex('fg')}"
background    = "{t.hex('bg')}"
cursor_bg     = "{t.extra.get('cursor', t.hex('accent'))}"
cursor_fg     = "{t.hex('bg')}"
cursor_border = "{t.hex('accent')}"
selection_fg  = "{t.hex('fg')}"
selection_bg  = "{t.hex('bg_selected')}"
scrollbar_thumb = "{t.hex('bg_raised')}"
split         = "{t.hex('outline')}"
ansi    = [{q(ansi)}]
brights = [{q(bright)}]

[colors.tab_bar]
background = "{t.hex('bg_dim')}"

[colors.tab_bar.active_tab]
bg_color = "{t.hex('bg')}"
fg_color = "{t.hex('accent')}"
intensity = "Bold"

[colors.tab_bar.inactive_tab]
bg_color = "{t.hex('bg_dim')}"
fg_color = "{t.hex('fg_muted')}"

[colors.tab_bar.inactive_tab_hover]
bg_color = "{t.hex('bg_raised')}"
fg_color = "{t.hex('fg')}"

[colors.tab_bar.new_tab]
bg_color = "{t.hex('bg_dim')}"
fg_color = "{t.hex('fg_muted')}"

[colors.tab_bar.new_tab_hover]
bg_color = "{t.hex('bg_raised')}"
fg_color = "{t.hex('fg')}"
""", dry)


def r_gtk(t: Theme, dry: bool) -> None:
    bm = _breeze_map(t)
    body = "".join(f"@define-color {k} {v};\n" for k, v in sorted(bm.items()))
    # Plain semantic aliases too, for our own waybar/swaync-style overrides.
    extra = "".join(f"@define-color {r} {h};\n" for r, h in sorted(t.role.items()))
    content = (f"/* {BANNER} */\n/* Theme: {t.name} */\n\n"
               f"/* Breeze widget-theme colour contract */\n{body}\n"
               f"/* semantic aliases */\n{extra}")
    for v in ("3.0", "4.0"):
        write(CFG / f"gtk-{v}/colors.css", content, dry)


def r_kde(t: Theme, dry: bool) -> None:
    """KDE colour scheme -> themes the Qt file dialog and Dolphin."""
    sel_bg, sel_fg = t.kde("accent"), t.kde("accent_text")
    bg, fg = t.kde("bg"), t.kde("fg")
    view_bg = t.kde("bg_dim")
    btn_bg = t.kde("bg_raised")
    hdr_bg = t.kde("bg_dim")

    def block(name, background, foreground, alt=None):
        alt = alt or background
        return f"""[Colors:{name}]
BackgroundNormal={background}
BackgroundAlternate={alt}
ForegroundNormal={foreground}
ForegroundInactive={t.kde('fg_muted')}
ForegroundActive={t.kde('accent')}
ForegroundLink={t.kde('info')}
ForegroundVisited={t.kde_hex(t.extra.get('link_visited', t.hex('accent')))}
ForegroundNegative={t.kde('error')}
ForegroundNeutral={t.kde('warning')}
ForegroundPositive={t.kde('success')}
DecorationFocus={t.kde('accent')}
DecorationHover={t.kde('accent_dim')}
"""

    content = f"""[General]
Name={t.name}
ColorScheme={t.name.replace(' ', '')}
shadeSortColumn=true

{block('Window', bg, fg, t.kde('bg_dim'))}
{block('View', view_bg, fg, t.kde('bg'))}
{block('Button', btn_bg, fg, t.kde('bg_raised'))}
{block('Selection', sel_bg, sel_fg, sel_bg)}
{block('Tooltip', t.kde('bg_raised'), fg)}
{block('Complementary', t.kde('bg_deep'), fg)}
{block('Header', hdr_bg, fg)}
[WM]
activeBackground={hdr_bg}
activeForeground={fg}
inactiveBackground={t.kde('bg')}
inactiveForeground={t.kde('fg_muted')}
frame={t.kde('accent')}
inactiveFrame={t.kde('outline_inactive')}
"""
    scheme = HOME / ".local/share/color-schemes" / f"{t.name.replace(' ', '')}.colors"
    write(scheme, content, dry)


def r_kdeglobals(t: Theme, dry: bool) -> None:
    """
    Qt/Breeze reads the [Colors:*] blocks out of kdeglobals directly --
    `ColorScheme=` is only a label. Installing the .colors file is not enough;
    applying a scheme means merging its colour blocks into kdeglobals, which is
    what KDE's own 'apply colour scheme' does. We replicate that here so the
    Qt file dialog and Dolphin actually follow the palette.

    Every non-colour section of kdeglobals is preserved untouched.
    """
    import re
    kg = CFG / "kdeglobals"
    existing = kg.read_text() if kg.exists() else ""

    scheme_path = HOME / ".local/share/color-schemes" / f"{t.name.replace(' ', '')}.colors"
    if not scheme_path.exists():
        return
    generated = scheme_path.read_text()

    # lift the [Colors:*] and [WM] blocks out of the generated scheme
    blocks: dict[str, str] = {}
    cur = None
    for line in generated.splitlines():
        m = re.match(r"^\[(Colors:[^\]]+|WM)\]$", line)
        if m:
            cur = m.group(1)
            blocks[cur] = ""
            continue
        if line.startswith("["):
            cur = None
            continue
        if cur is not None and line.strip():
            blocks[cur] += line + "\n"

    # drop stale colour sections from kdeglobals, keep everything else
    out, skip = [], False
    for line in existing.splitlines():
        m = re.match(r"^\[([^\]]+)\]$", line)
        if m:
            name = m.group(1)
            skip = name.startswith("Colors:") or name == "WM" or name.startswith("ColorEffects:")
        if not skip:
            out.append(line)

    body = "\n".join(out).rstrip() + "\n"
    # own the scheme label too, so a rename can't leave a stale value behind
    scheme_name = t.name.replace(" ", "")
    if re.search(r"^ColorScheme=.*$", body, flags=re.M):
        body = re.sub(r"^ColorScheme=.*$", f"ColorScheme={scheme_name}",
                      body, count=1, flags=re.M)
    elif "[General]" in body:
        body = body.replace("[General]\n", f"[General]\nColorScheme={scheme_name}\n", 1)
    else:
        body += f"\n[General]\nColorScheme={scheme_name}\n"
    for name, content in blocks.items():
        body += f"\n[{name}]\n{content}"
    write(kg, body, dry)



# --------------------------------------------------------------------------
# verification + live reload
# --------------------------------------------------------------------------
def check_breeze_contract(t: Theme) -> list[str]:
    """Every @*_breeze name the installed theme dereferences must be defined."""
    import re
    needed: set[str] = set()
    for f in BREEZE_CSS:
        if f.exists():
            needed |= set(re.findall(r"@([a-z0-9_]+_breeze)", f.read_text()))
    # names the theme defines for itself don't need to come from us
    selfdef: set[str] = set()
    for f in BREEZE_CSS:
        if f.exists():
            selfdef |= set(re.findall(r"@define-color\s+([a-z0-9_]+_breeze)", f.read_text()))
    return sorted(needed - selfdef - set(_breeze_map(t)))


def run(cmd: list[str]) -> bool:
    try:
        return subprocess.run(cmd, capture_output=True, timeout=10).returncode == 0
    except Exception:
        return False


def reload_all(t: Theme) -> None:
    results = []

    results.append(("hyprland", run(["hyprctl", "reload"])))

    # waybar reloads its stylesheet on SIGUSR2
    results.append(("waybar", run(["pkill", "-USR2", "-x", "waybar"])))

    results.append(("swaync", run(["swaync-client", "--reload-css"])))

    if t.wallpaper:
        results.append(("wallpaper", run(["systemctl", "--user", "restart",
                                          "hypr-wallpaper.service"])))

    # kitty only listens when remote control is enabled; harmless if not
    results.append(("kitty", run(["kitten", "@", "set-colors", "--all", "--configured",
                                  str(CFG / "kitty/current-theme.conf")])))

    # kdeglobals is written by r_kdeglobals -- deliberately no kwriteconfig6
    # here, which would reformat the file and make the next run non-idempotent.
    # Qt apps read it at launch, so there is nothing to signal.
    results.append(("kde/qt", True))

    # Nudge GTK apps: toggling the theme name forces a re-read of colors.css
    run(["gsettings", "set", "org.gnome.desktop.interface", "gtk-theme", "Adwaita"])
    run(["gsettings", "set", "org.gnome.desktop.interface", "gtk-theme", "Breeze-Dark"])
    results.append(("gtk", True))

    print("\nreload:")
    for name, ok in results:
        print(f"  {'ok  ' if ok else 'skip'} {name}")


# --------------------------------------------------------------------------
def main() -> None:
    ap = argparse.ArgumentParser(description="Render all themed configs from palette.toml")
    ap.add_argument("--no-reload", action="store_true", help="write files only")
    ap.add_argument("--dry-run", action="store_true", help="show what would change")
    ap.add_argument("--check", action="store_true", help="verify colour contracts only")
    args = ap.parse_args()

    t = load()
    print(f"theme: {t.name}  accent: {t.hex('accent')}")

    missing = check_breeze_contract(t)
    if missing:
        print(f"\nWARNING: {len(missing)} Breeze colour(s) referenced but not generated:")
        for m in missing:
            print(f"  - {m}")
    else:
        print("breeze colour contract: complete")

    if args.check:
        sys.exit(1 if missing else 0)

    for fn in (r_hyprland, r_hyprlock, r_waybar, r_swaync,
               r_fuzzel, r_kitty, r_wezterm, r_wallpaper,
               r_gtk, r_kde, r_kdeglobals):
        fn(t, args.dry_run)

    verb = "would write" if args.dry_run else "wrote"
    print(f"\n{verb} {len(WRITTEN)} file(s), {len(SKIPPED)} unchanged:")
    for p in WRITTEN:
        print(f"  + {p}")

    if not args.no_reload and not args.dry_run:
        reload_all(t)


if __name__ == "__main__":
    main()
