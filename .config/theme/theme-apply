"""
    scheme = HOME / ".local/share/color-schemes" / f"{t.name.replace(' ', '')}.colors"
    write(scheme, content, dry)


def r_kdeglobals(t: Theme, dry: bool) -> None:
    """
    Qt/Breeze reads the [Colors:*] blocks out of kdeglobals directly --
    `ColorScheme=` is only a label. Installing the .colors file is not enough;
    applying a scheme means merging its colour blocks into kdeglobals, which is
    what KDE's own 'apply colour scheme' does. We replicate that here so the
    Qt file dialog and Dolphin actually follow the palette.

    Every non-colour section of kdeglobals is preserved untouched.
    """
    import re
    kg = CFG / "kdeglobals"
    existing = kg.read_text() if kg.exists() else ""

    scheme_path = HOME / ".local/share/color-schemes" / f"{t.name.replace(' ', '')}.colors"
    if not scheme_path.exists():
        return
    generated = scheme_path.read_text()

    # lift the [Colors:*] and [WM] blocks out of the generated scheme
    blocks: dict[str, str] = {}
    cur = None
    for line in generated.splitlines():
        m = re.match(r"^\[(Colors:[^\]]+|WM)\]$", line)
        if m:
            cur = m.group(1)
            blocks[cur] = ""
            continue
        if line.startswith("["):
            cur = None
            continue
        if cur is not None and line.strip():
            blocks[cur] += line + "\n"

    # drop stale colour sections from kdeglobals, keep everything else
    out, skip = [], False
    for line in existing.splitlines():
        m = re.match(r"^\[([^\]]+)\]$", line)
        if m:
            name = m.group(1)
            skip = name.startswith("Colors:") or name == "WM" or name.startswith("ColorEffects:")
        if not skip:
            out.append(line)

    body = "\n".join(out).rstrip() + "\n"
    # own the scheme label too, so a rename can't leave a stale value behind
    scheme_name = t.name.replace(" ", "")
    if re.search(r"^ColorScheme=.*$", body, flags=re.M):
        body = re.sub(r"^ColorScheme=.*$", f"ColorScheme={scheme_name}",
                      body, count=1, flags=re.M)
    elif "[General]" in body:
        body = body.replace("[General]\n", f"[General]\nColorScheme={scheme_name}\n", 1)
    else:
        body += f"\n[General]\nColorScheme={scheme_name}\n"
    for name, content in blocks.items():
        body += f"\n[{name}]\n{content}"
    write(kg, body, dry)



