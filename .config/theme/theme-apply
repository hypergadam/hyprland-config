def r_shell_colors(t: Theme, dry: bool) -> None:
    """
    The CLI tools that take colour through the environment, in one sourceable
    file: fzf, eza, and LS_COLORS -- which also drives the zsh completion menu
    via `zstyle ':completion:*' list-colors`.

    .zshrc sources this and composes the non-colour options itself, so layout
    preferences (fzf --height, --layout) stay hand-editable.
    """
    k = t.term

    # fzf. bg and gutter are left at -1 so the terminal's own translucency
    # shows through the finder instead of being painted over.
    fzf = ",".join([
        f"fg:{t.hex('fg_muted')}",
        "bg:-1",
        f"hl:{t.hex('accent')}",
        f"fg+:{t.hex('fg')}",
        f"bg+:{t.hex('bg_selected')}",
        f"hl+:{t.hex('accent_dim')}",
        f"info:{t.hex('fg_disabled')}",
        f"border:{t.hex('outline')}",
        f"prompt:{t.hex('accent')}",
        f"pointer:{t.hex('accent')}",
        f"marker:{t.hex('success')}",
        f"spinner:{t.hex('warning')}",
        f"header:{t.hex('info')}",
        "gutter:-1",
        f"label:{t.hex('fg_muted')}",
        f"query:{t.hex('fg')}",
    ])

    # eza. Permission bits follow the usual read/write/execute = yellow/red/green
    # convention; everything structural is dimmed so filenames carry the eye.
    eza = ":".join([
        f"hd=1;{_sgr(t.hex('accent'))}",          # column headers
        f"di=1;{_sgr(t.hex('info'))}",            # directories
        f"ex=1;{_sgr(t.hex('success'))}",         # executables
        f"ln={_sgr(k['cyan'])}",                  # symlinks
        f"lp={_sgr(t.hex('fg_disabled'))}",       # symlink target path
        f"or=1;{_sgr(t.hex('error'))}",           # broken symlink
        f"ur={_sgr(k['yellow'])}", f"uw={_sgr(k['red'])}", f"ux={_sgr(k['green'])}",
        f"ue={_sgr(k['green'])}",
        f"gr={_sgr(k['yellow'])}", f"gw={_sgr(k['red'])}", f"gx={_sgr(k['green'])}",
        f"tr={_sgr(k['yellow'])}", f"tw={_sgr(k['red'])}", f"tx={_sgr(k['green'])}",
        f"sn={_sgr(t.hex('success'))}",           # size number
        f"sb={_sgr(t.hex('fg_disabled'))}",       # size unit
        f"uu={_sgr(t.hex('fg_muted'))}",          # owner: you
        f"un={_sgr(t.hex('fg_disabled'))}",       # owner: someone else
        f"gu={_sgr(t.hex('fg_muted'))}", f"gn={_sgr(t.hex('fg_disabled'))}",
        f"da={_sgr(t.hex('fg_muted'))}",          # dates
        f"ga={_sgr(t.hex('success'))}",           # git: new
        f"gm={_sgr(t.hex('warning'))}",           # git: modified
        f"gd={_sgr(t.hex('error'))}",             # git: deleted
        f"gv={_sgr(k['magenta'])}",               # git: renamed
        f"gt={_sgr(k['cyan'])}",                  # git: type change
        f"xx={_sgr(t.hex('fg_disabled'))}",       # punctuation / dashes
    ])

    # LS_COLORS, also read by the zsh completion menu.
    groups = [
        (t.hex("error"),  ["*.tar", "*.tgz", "*.zip", "*.gz", "*.bz2", "*.xz",
                           "*.zst", "*.7z", "*.rar", "*.rpm", "*.deb"]),
        (k["magenta"],    ["*.jpg", "*.jpeg", "*.png", "*.gif", "*.webp",
                           "*.svg", "*.bmp", "*.ico", "*.tif", "*.tiff"]),
        (k["bright_magenta"], ["*.mp4", "*.mkv", "*.webm", "*.mov", "*.avi"]),
        (k["cyan"],       ["*.mp3", "*.flac", "*.ogg", "*.opus", "*.wav", "*.m4a"]),
        (k["yellow"],     ["*.pdf", "*.epub", "*.md", "*.txt", "*.rst",
                           "*.doc", "*.docx", "*.odt"]),
        (k["bright_blue"], ["*.go", "*.py", "*.rs", "*.c", "*.h", "*.cpp",
                            "*.js", "*.ts", "*.tsx", "*.sh", "*.zsh", "*.lua"]),
        (t.hex("fg_disabled"), ["*.toml", "*.yaml", "*.yml", "*.json", "*.ini",
                                "*.conf", "*.kdl", "*.lock"]),
    ]
    ls = [
        "rs=0",
        f"di=1;{_sgr(t.hex('info'))}",
        f"ln={_sgr(k['cyan'])}",
        "mh=00",
        f"pi={_sgr(k['yellow'])};{_sgr(t.hex('bg_dim'), bg=True)}",
        f"so={_sgr(k['magenta'])}",
        f"do={_sgr(k['magenta'])}",
        f"bd={_sgr(k['yellow'])};{_sgr(t.hex('bg_dim'), bg=True)}",
        f"cd={_sgr(k['yellow'])};{_sgr(t.hex('bg_dim'), bg=True)}",
        f"or=1;{_sgr(t.hex('error'))}",
        f"mi=1;{_sgr(t.hex('error'))}",
        f"su={_sgr(t.hex('accent_text'))};{_sgr(t.hex('error'), bg=True)}",
        f"sg={_sgr(t.hex('accent_text'))};{_sgr(t.hex('warning'), bg=True)}",
        "ca=0",
        f"tw={_sgr(t.hex('success'))};{_sgr(t.hex('bg_raised'), bg=True)}",
        f"ow=1;{_sgr(t.hex('info'))}",
        f"st={_sgr(t.hex('info'))}",
        f"ex=1;{_sgr(t.hex('success'))}",
    ]
    for colour, exts in groups:
        ls += [f"{e}={_sgr(colour)}" for e in exts]

    write(THEME_DIR / "shell-colors.sh", f"""# {BANNER}
# Theme: {t.name}
#
# Sourced by ~/.zshrc. Colour only -- layout and behaviour options live there.

FZF_COLORS="--color={fzf}"
export FZF_COLORS

EZA_COLORS="{eza}"
export EZA_COLORS

LS_COLORS="{':'.join(ls)}"
export LS_COLORS

# zsh-autosuggestions wants a zle highlight spec, not an SGR run.
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE="fg={t.hex('fg_disabled')}"
export ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE
""", dry)


