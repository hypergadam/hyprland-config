      "exec": "cat \"${XDG_STATE_HOME:-$HOME/.local/state}/hypr-panel/workspaces/9.json\" 2>/dev/null || printf '%s\\n' '{\"text\": \"9\", \"class\": [\"workspace-button\"]}'",
