      "return-type": "json",
      "signal": 8,
      "on-click": "hyprctl eval 'hl.dispatch(hl.dsp.focus({ workspace = \"6\" }))'"
    },
    "custom/workspace7": {
      "exec": "cat \"${XDG_STATE_HOME:-$HOME/.local/state}/hypr-panel/workspaces/7.json\" 2>/dev/null || printf '%s\\n' '{\"text\": \"7\", \"class\": [\"workspace-button\"]}'",
      "return-type": "json",
