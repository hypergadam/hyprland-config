      },
      "format": "{icon}  {capacity}%",
      "format-icons": [
        "󰁺",
        "󰁼",
        "󰁾",
        "󰂀",
        "󰁹"
      ],
      "format-charging": "󰂄  {capacity}%",
      "format-full": "󰁹  {capacity}%",
      "tooltip-format": "{capacity}% · {timeTo}"
    },
    "custom/notifications": {
      "format": "󰂚",
      "tooltip-format": "Click to open notifications · Super+N",
      "on-click": "swaync-client -t"
    },
    "tray": {
      "icon-size": 18,
      "spacing": 10
    },
    "custom/power": {
      "format": "󰐥",
      "tooltip-format": "Power: sleep, restart, or shut down",
      "on-click": "sh ~/.config/hypr/power-menu.sh"
    },
    "backlight": {
      "device": "amdgpu_bl1",
      "format": "󰃠  {percent}%",
      "tooltip-format": "Laptop screen brightness: {percent}%\nLeft-click / scroll up: brighter (+5%)\nRight-click / scroll down: dimmer (-5%)",
      "on-scroll-up": "sh ~/.config/hypr/brightness.sh on eDP-1 up",
      "on-scroll-down": "sh ~/.config/hypr/brightness.sh on eDP-1 down",
      "on-click": "sh ~/.config/hypr/brightness.sh on eDP-1 up",
      "on-click-right": "sh ~/.config/hypr/brightness.sh on eDP-1 down"
    },
    "custom/launcher": {
      "format": "",
      "tooltip-format": "Fedora · Applications · Super+Space",
      "on-click": "fuzzel"
    },
    "mpris": {
      "format": "{status_icon}",
      "format-paused": "{status_icon}",
      "format-stopped": "",
      "status-icons": {
        "playing": "󰏤",
        "paused": "󰐊",
        "stopped": "󰐊"
      },
      "tooltip-format": "{title}\n{artist}\nClick: play/pause · Right-click: next · Scroll: prev/next",
      "on-click": "playerctl play-pause",
      "on-click-right": "playerctl next",
      "on-scroll-up": "playerctl next",
