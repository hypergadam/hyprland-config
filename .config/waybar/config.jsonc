// Waybar - omarchy-style flat bar, identical on both outputs.
// Colours live in colors.css, generated from ~/.config/theme/palette.toml.
// Module definitions (formats, tooltips, click actions) are unchanged.
// Brightness: the laptop bar uses the built-in backlight module on amdgpu_bl1;
// the desktop bar drives the AOC over DDC/CI via ~/.config/hypr/brightness.sh.
// mpris is icon-only: a transport button, no track title.
// wireplumber: compact readout, scroll adjusts, click mutes.
[
  {
    "name": "desktop",
    "output": "HDMI-A-1",
    "layer": "top",
    "position": "top",
    "height": 28,
    "spacing": 0,
    "margin-top": 0,
    "margin-left": 0,
    "margin-right": 0,
    "margin-bottom": 0,
    "modules-left": [
      "custom/launcher",
      "group/workspaces",
      "mpris"
    ],
    "modules-center": [
      "clock"
    ],
    "modules-right": [
      "cpu",
      "memory",
      "temperature",
      "custom/backlight",
      "wireplumber",
      "network",
      "bluetooth",
      "battery",
      "custom/notifications",
      "tray",
      "custom/power"
    ],
    "group/workspaces": {
      "orientation": "horizontal",
      "modules": [
        "custom/workspace1",
        "custom/workspace2",
        "custom/workspace3",
        "custom/workspace4",
        "custom/workspace5"
      ]
    },
    "cpu": {
      "interval": 5,
      "format": "󰻠  {usage}%",
      "tooltip-format": "CPU usage: {usage}%"
    },
    "memory": {
      "interval": 5,
      "format": "󰍛  {percentage}%",
      "tooltip-format": "{used:.1f} / {total:.1f} GiB used"
    },
    "wireplumber": {
      "format": "{icon} {volume}%",
      "format-icons": [
        "󰕿",
        "󰖀",
        "󰕾"
      ],
      "format-muted": "󰝟",
      "scroll-step": 5,
      "max-volume": 100,
      "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
      "on-click-right": "kcmshell6 kcm_pulseaudio",
      "tooltip-format": "{node_name}\nScroll: volume · Click: mute · Right-click: sound settings"
    },
    "clock": {
      "format": "{:%a, %d %b  ·  %H:%M}",
      "tooltip-format": "{:%A, %d %B %Y}\n{calendar}",
      "calendar": {
        "mode": "month",
        "weeks-pos": "right",
        "on-scroll": 1
      }
    },
    "network": {
      "format-wifi": "󰖩  {signalStrength}%",
      "format-ethernet": "󰈀  Online",
      "format-linked": "󰈀",
      "format-disconnected": "󰖪",
      "tooltip-format": "{essid}\n{ifname}: {ipaddr}\nClick: connection manager · Right-click: advanced settings",
      "on-click": "python3 ~/.config/hypr/connections.py",
      "on-click-right": "nm-connection-editor",
      "max-length": 18
    },
    "bluetooth": {
      "format": "󰂯",
      "tooltip-format": "Bluetooth: {status}",
      "format-connected": "󰂱  {num_connections}",
      "tooltip-format-connected": "{device_enumerate}",
      "format-disabled": "󰂲",
      "format-off": "󰂲",
      "on-click": "blueman-manager"
    },
    "battery": {
      "bat": "BAT0",
      "interval": 30,
      "states": {
        "warning": 25,
        "critical": 10
      },
      "format": "{icon}  {capacity}%",
      "format-icons": [
        "󰁺",
        "󰁼",
        "󰁾",
        "󰂀",
        "󰁹"
      ],
      "format-charging": "󰂄  {capacity}%",
      "format-full": "󰁹  {capacity}%",
      "tooltip-format": "{capacity}% · {timeTo}"
    },
    "custom/notifications": {
      "format": "󰂚",
      "tooltip-format": "Click to open notifications · Super+N",
      "on-click": "swaync-client -t"
    },
    "tray": {
      "icon-size": 18,
      "spacing": 10
    },
    "custom/power": {
      "format": "󰐥",
      "tooltip-format": "Power: sleep, restart, or shut down",
      "on-click": "sh ~/.config/hypr/power-menu.sh"
    },
    "custom/backlight": {
      "exec": "sh ~/.config/hypr/brightness.sh get HDMI-A-1",
      "signal": 9,
      "format": "󰃠  {}%",
      "tooltip": true,
      "tooltip-format": "External monitor brightness over DDC/CI\nLeft-click / scroll up: brighter (+5%)\nRight-click / scroll down: dimmer (-5%)",
      "on-scroll-up": "sh ~/.config/hypr/brightness.sh on HDMI-A-1 up",
      "on-scroll-down": "sh ~/.config/hypr/brightness.sh on HDMI-A-1 down",
      "on-click": "sh ~/.config/hypr/brightness.sh on HDMI-A-1 up",
      "on-click-right": "sh ~/.config/hypr/brightness.sh on HDMI-A-1 down"
    },
    "custom/launcher": {
      "format": "",
      "tooltip-format": "Fedora · Applications · Super+Space",
      "on-click": "fuzzel"
    },
    "mpris": {
      "format": "{status_icon}",
      "format-paused": "{status_icon}",
      "format-stopped": "",
      "status-icons": {
        "playing": "󰏤",
        "paused": "󰐊",
        "stopped": "󰐊"
      },
      "tooltip-format": "{title}\n{artist}\nClick: play/pause · Right-click: next · Scroll: prev/next",
      "on-click": "playerctl play-pause",
      "on-click-right": "playerctl next",
      "on-scroll-up": "playerctl next",
      "on-scroll-down": "playerctl previous"
    },
    "temperature": {
      "hwmon-path-abs": "/sys/devices/pci0000:00/0000:00:18.3/hwmon",
      "input-filename": "temp1_input",
      "interval": 10,
      "format": "󰔏  {temperatureC}°C",
      "tooltip-format": "CPU temperature (AMD Tctl): {temperatureC}°C",
      "warning-threshold": 80,
      "critical-threshold": 95
    },
    "custom/workspace1": {
      "exec": "cat \"${XDG_STATE_HOME:-$HOME/.local/state}/hypr-panel/workspaces/1.json\" 2>/dev/null || printf '%s\\n' '{\"text\": \"1\", \"class\": [\"workspace-button\"]}'",
      "return-type": "json",
      "signal": 8,
      "on-click": "hyprctl eval 'hl.dispatch(hl.dsp.focus({ workspace = \"1\" }))'"
    },
    "custom/workspace2": {
      "exec": "cat \"${XDG_STATE_HOME:-$HOME/.local/state}/hypr-panel/workspaces/2.json\" 2>/dev/null || printf '%s\\n' '{\"text\": \"2\", \"class\": [\"workspace-button\"]}'",
      "return-type": "json",
      "signal": 8,
      "on-click": "hyprctl eval 'hl.dispatch(hl.dsp.focus({ workspace = \"2\" }))'"
    },
    "custom/workspace3": {
      "exec": "cat \"${XDG_STATE_HOME:-$HOME/.local/state}/hypr-panel/workspaces/3.json\" 2>/dev/null || printf '%s\\n' '{\"text\": \"3\", \"class\": [\"workspace-button\"]}'",
      "return-type": "json",
      "signal": 8,
      "on-click": "hyprctl eval 'hl.dispatch(hl.dsp.focus({ workspace = \"3\" }))'"
    },
    "custom/workspace4": {
      "exec": "cat \"${XDG_STATE_HOME:-$HOME/.local/state}/hypr-panel/workspaces/4.json\" 2>/dev/null || printf '%s\\n' '{\"text\": \"4\", \"class\": [\"workspace-button\"]}'",
      "return-type": "json",
      "signal": 8,
      "on-click": "hyprctl eval 'hl.dispatch(hl.dsp.focus({ workspace = \"4\" }))'"
    },
    "custom/workspace5": {
      "exec": "cat \"${XDG_STATE_HOME:-$HOME/.local/state}/hypr-panel/workspaces/5.json\" 2>/dev/null || printf '%s\\n' '{\"text\": \"5\", \"class\": [\"workspace-button\"]}'",
      "return-type": "json",
      "signal": 8,
      "on-click": "hyprctl eval 'hl.dispatch(hl.dsp.focus({ workspace = \"5\" }))'"
    }
  },
  {
    "name": "laptop",
    "output": "eDP-1",
    "layer": "top",
    "position": "top",
    "height": 28,
    "spacing": 0,
    "margin-top": 0,
    "margin-left": 0,
    "margin-right": 0,
    "margin-bottom": 0,
    "modules-left": [
      "custom/launcher",
