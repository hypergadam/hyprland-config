      "mpris"
    ],
    "modules-center": [
      "clock"
    ],
    "modules-right": [
      "cpu",
      "memory",
      "temperature",
      "backlight",
      "wireplumber",
      "network",
      "bluetooth",
      "battery",
      "custom/notifications",
      "tray",
      "custom/power"
    ],
    "group/workspaces": {
      "orientation": "horizontal",
      "modules": [
        "custom/workspace6",
        "custom/workspace7",
        "custom/workspace8",
        "custom/workspace9",
        "custom/workspace10"
      ]
    },
    "cpu": {
